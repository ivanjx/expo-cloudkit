{
  "name": "expo-cloudkit",
  "version": "0.21.0-fork.0",
  "description": "Expo native module for CloudKit — records, zones, sharing, and sync",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "ios",
    "docs",
    "CHANGELOG.md",
    "app.plugin.js",
    "transport.js",
    "transport.d.ts",
    "expo-module.config.json",
    "ExpoCloudKit.podspec",
    "Package.swift"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p plugin/tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf build",
    "test": "jest"
  },
  "keywords": [
    "expo",
    "cloudkit",
    "icloud",
    "react-native",
    "ios",
    "sync"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivanjx/expo-cloudkit"
  },
  "bugs": {
    "url": "https://github.com/ivanjx/expo-cloudkit/issues"
  },
  "homepage": "https://github.com/ivanjx/expo-cloudkit#readme",
  "peerDependencies": {
    "expo": ">=51.0.0",
    "expo-modules-core": ">=1.12.0",
    "react": ">=18.0.0",
    "tsl-apple-cloudkit": ">=0.2.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "tsl-apple-cloudkit": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expo": "57.0.12",
    "expo-modules-core": "~57.0.10",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  }
}
